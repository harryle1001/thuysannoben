# Cổng chạy ứng dụng (Hostinger tự đặt biến PORT, không cần sửa)
PORT=3000
# Địa chỉ website chính thức, dùng cho sitemap, thẻ canonical, Open Graph
SITE_URL=https://thuysannoben.vn
# Tên miền cũ hoặc phụ: ai vào bằng các tên miền này sẽ được chuyển 301 sang SITE_URL
OLD_HOSTS=thuocthuysannoben.com,www.thuocthuysannoben.com,www.thuysannoben.vn

# Gửi email khi khách điền form liên hệ (dùng email Hostinger hoặc Gmail App Password)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=lienhe@thuysannoben.vn
SMTP_PASS=
MAIL_TO=thuocthuysannoben@gmail.com

# Tài khoản xem danh sách khách liên hệ tại /quan-tri/lien-he
ADMIN_USER=admin
ADMIN_PASS=
