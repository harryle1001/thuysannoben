# Cổng chạy ứng dụng (Hostinger tự đặt biến PORT, không cần sửa)
PORT=3000
# Địa chỉ website chính thức, dùng cho sitemap, thẻ canonical, Open Graph
SITE_URL=https://thuysannoben.com
# Tên miền cũ hoặc phụ: ai vào bằng các tên miền này sẽ được chuyển 301 sang SITE_URL
OLD_HOSTS=www.thuysannoben.com,thuocthuysannoben.com,www.thuocthuysannoben.com,thuysannoben.vn,www.thuysannoben.vn

# Mã xác minh Google Search Console (phương thức "Thẻ HTML"): chỉ dán phần content="..."
GOOGLE_SITE_VERIFICATION=

# Gửi email khi khách điền form liên hệ (dùng email Hostinger hoặc Gmail App Password)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=lienhe@thuysannoben.com
SMTP_PASS=
MAIL_TO=thuocthuysannoben@gmail.com

# Tài khoản xem danh sách khách liên hệ tại /quan-tri/lien-he
ADMIN_USER=admin
ADMIN_PASS=

# Trợ lý Noben (chatbot AI). Lấy khóa tại https://platform.claude.com, để trống thì trợ lý
# vẫn chạy ở chế độ tìm kiếm trong nội dung website và mời khách gọi hotline / Zalo.
ANTHROPIC_API_KEY=
# Số câu trả lời AI tối đa mỗi ngày (giới hạn chi phí). Mặc định 800.
CHAT_DAILY_LIMIT=800
