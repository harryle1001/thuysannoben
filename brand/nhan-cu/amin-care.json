    {
     "kieu": "html",
     "chu": "<b>CÔNG DỤNG</b>"
    },
    {
     "kieu": "gach",
     "chu": "Bổ sung đạm cá, acid amin thiết yếu cho tôm, cá. Giúp tôm, cá ham ăn, chóng lớn. Giúp tôm, cá bắt mồi nhanh do có mùi tanh hấp dẫn."
    },
    {
     "kieu": "gach",
     "chu": "Hỗ trợ tăng đề kháng, tăng cường hấp thụ chất dinh dưỡng, hạn chế mềm vỏ, chậm lớn, bắt mồi kém."
    },
    {
     "kieu": "html",
     "chu": "<b>HƯỚNG DẪN SỬ DỤNG</b>"
    },
    {
     "kieu": "gach",
     "chu": "Trộn 3-5 ml/kg thức ăn, sử dụng 3 lần/ngày trong suốt vụ nuôi."
    },
    {
     "kieu": "gach",
     "chu": "Trường hợp tôm, cá bị bệnh, bắt mồi kém, chậm lớn: Trộn tăng liều gấp đôi, cho ăn 3-5 ngày sau đó cho ăn với liều lượng bình thường."
    },
    {
     "kieu": "gach",
     "chu": "Hòa sản phẩm với lượng nước vừa đủ rồi trộn đều vào thức ăn, để ráo trước khi cho ăn."
    },
    {
     "kieu": "gach",
     "chu": "Thời hạn sử dụng: Sử dụng trong suốt quá trình nuôi."
    },
    {
     "kieu": "gach",
     "chu": "Tránh xa trẻ em, đậy kín sản phẩm sau khi sử dụng."
    }
