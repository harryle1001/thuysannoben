   "noi_dung": [
    {
     "kieu": "html",
     "chu": "<b style=\"color:#e0242c\">THÀNH PHẦN:</b> trong 1kg sản phẩm"
    },
    {
     "kieu": "dong",
     "chu": "Ethylene diamine tetra acetic acid (min): 300mg/kg"
    },
    {
     "kieu": "dong",
     "chu": "Chất đệm (Dextrose) vừa đủ: 1kg"
    },
    {
     "kieu": "dong",
