    },
    {
     "kieu": "dong",
     "chu": "Asen (As): KPH"
    },
    {
     "kieu": "dong",
     "chu": "Chì (Pb): KPH"
    },
    {
     "kieu": "html",
     "chu": "<b style=\"color:#e0242c\">CÔNG DỤNG:</b>"
    },
    {
     "kieu": "dong",
     "chu": "- Khử kim loại nặng, thuốc trừ sâu, hóa chất, phèn đáy.... tồn dư ở đáy ao."
    },
    {
     "kieu": "dong",
     "chu": "- Giúp làm sạch nguồn nước ao nuôi."
    },
    {
     "kieu": "html",
     "chu": "<b style=\"color:#e0242c\">LIỀU LƯỢNG - CÁCH DÙNG</b>"
    },
    {
     "kieu": "html",
     "chu": "- <b>Khử kim loại nặng:</b> 0,6 - 1kg EDTA 99/1.000m³, định kỳ 7 - 10 ngày."
    },
    {
     "kieu": "dong",
     "chu": "- Khi tôm nổi đầu, tấp mé, tôm khó lột vỏ do hàm lượng kim loại nặng cao dùng EDTA 99 liều cao gấp 1,5 lần."
    },
    {
     "kieu": "html",
     "chu": "- <b>Xử lý tảo tàn, giảm keo nhầy sử dụng:</b> 0,3 - 0,6 kg EDTA 99/1.000m³"
    },
    {
     "kieu": "html",
     "chu": "- <b>Phân hủy thuốc trừ sâu và dư lượng hóa chất, cấp cứu nổi đầu:</b> Sử dụng 1kg EDTA/1.000m³ nước."
    },
    {
     "kieu": "dong",
     "chu": "- Thời hạn sử dụng: Sử dụng trong suốt quá trình nuôi."
    },
    {
     "kieu": "html",
     "chu": "<b style=\"color:#e0242c\">BẢO QUẢN:</b> Nơi khô, thoáng, tránh ánh nắng trực tiếp. Để xa tầm tay trẻ em."
    }
   ]
