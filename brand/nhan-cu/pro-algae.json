          "kieu": "html",
          "chu": "<b style=\"display:block;margin-top:0.35em\">CÔNG DỤNG</b>"
        },
        {
          "kieu": "gach",
          "chu": "Giúp phân huỷ mùn bã hữu cơ, thức ăn thừa, xác tảo tàn, phân tôm tích tụ ở đáy ao."
        },
        {
          "kieu": "gach",
          "chu": "Giảm khí độc NH<sub style=\"line-height:0;font-size:.72em\">3</sub>, H<sub style=\"line-height:0;font-size:.72em\">2</sub>S, cải thiện chất lượng môi trường ao nuôi, giảm mùi hôi."
        },
        {
          "kieu": "gach",
          "chu": "Hỗ trợ làm sạch nhớt bạt, nhớt nước ao nuôi."
        },
        {
          "kieu": "gach",
          "chu": "Hỗ trợ làm giảm tảo độc, hỗ trợ cắt tảo Lablab ao nuôi."
        },
        {
          "kieu": "html",
          "chu": "<b style=\"display:block;margin-top:0.35em\">HƯỚNG DẪN SỬ DỤNG</b>"
        },
        {
          "kieu": "gach",
          "chu": "Hòa với nước ao nuôi một lượng vừa đủ rồi tạt đều khắp ao với liều lượng như sau:"
        },
        {
          "kieu": "gach",
          "chu": "Chuẩn bị ao: Dùng 454g/2.000-2.500m<sup style=\"line-height:0;font-size:.72em\">3</sup> nước."
        },
        {
          "kieu": "gach",
          "chu": "Dùng định kỳ: Dùng 454g/3.000-5.000m<sup style=\"line-height:0;font-size:.72em\">3</sup> nước, định kỳ 5-7 ngày sử dụng 1 lần."
        },
        {
          "kieu": "gach",
          "chu": "Trường hợp ao bị ô nhiễm nặng: Dùng 1kg/2.000-3.000m<sup style=\"line-height:0;font-size:.72em\">3</sup> nước, dùng liên tục 2 ngày."
        },
        {
          "kieu": "gach",
          "chu": "Trường hợp làm giảm tảo, hỗ trợ cắt tảo Lablab: Dùng 1kg/2.000m<sup style=\"line-height:0;font-size:.72em\">3</sup> nước, sử dụng 2 ngày liên tục với liều như trên."
        },
        {
          "kieu": "gach",
          "chu": "Lưu ý: Sử dụng cho cắt tảo, giảm tảo nên sử dụng vào lúc 10-12 giờ đêm."
        },
        {
          "kieu": "gach",
          "chu": "Có thể ủ sục khí trước khi sử dụng từ trên 12 tiếng để tăng hiệu quả sử dụng của sản phẩm."
        },
        {
          "kieu": "gach",
          "chu": "Thời hạn sử dụng: Sử dụng trong suốt quá trình nuôi."
        },
        {
          "kieu": "gach",
          "chu": "Tránh xa trẻ em, đậy kín sản phẩm sau khi sử dụng."
        },
