        {
          "kieu": "html",
          "chu": "CÔNG DỤNG",
          "cl": "muc"
        },
        {
          "kieu": "dong",
          "chu": "- Giúp phân hủy mùn bã hữu cơ, thức ăn thừa, xác tảo tàn, phân tôm tích tụ ở đáy ao."
        },
        {
          "kieu": "html",
          "chu": "- Giảm khí độc NH<sub style=\"line-height:0\">3</sub>, H<sub style=\"line-height:0\">2</sub>S, cải thiện chất lượng môi trường ao nuôi, giảm mùi hôi."
        },
        {
          "kieu": "dong",
          "chu": "- Hỗ trợ làm sạch nhớt bạt, nhớt nước ao nuôi."
        },
        {
          "kieu": "dong",
          "chu": "- Hỗ trợ làm giảm tảo độc, hỗ trợ cắt tảo Lablab ao nuôi."
        },
        {
          "kieu": "html",
          "chu": "HƯỚNG DẪN SỬ DỤNG",
          "cl": "muc"
        },
        {
          "kieu": "dong",
          "chu": "Hòa với nước ao nuôi một lượng vừa đủ rồi tạt đều khắp ao với liều lượng như sau:"
        },
        {
          "kieu": "html",
          "chu": "<b>* Chuẩn bị ao:</b> Dùng 454g/2.000-2.500m³ nước."
        },
        {
          "kieu": "html",
          "chu": "<b>* Dùng định kỳ:</b> Dùng 454g/3.000-5.000m³ nước, định kỳ 5-7 ngày sử dụng 1 lần."
        },
        {
          "kieu": "html",
          "chu": "<b>* Trường hợp ao bị ô nhiễm nặng:</b> Dùng 1kg/2.000-3.000m³ nước, dùng liên tục 2 ngày."
        },
        {
          "kieu": "html",
          "chu": "<b>* Trường hợp làm giảm tảo, hỗ trợ cắt tảo Lablab:</b> Dùng 1kg/2.000m³ nước, sử dụng 2 ngày liên tục với liều như trên."
        },
        {
          "kieu": "dong",
          "chu": "Lưu ý: Sử dụng cho cắt tảo, giảm tảo nên sử dụng vào lúc 10-12 giờ đêm. Có thể ủ sục khí trước khi sử dụng từ trên 12 tiếng để tăng hiệu quả sử dụng của sản phẩm."
        },
        {
          "kieu": "dong",
          "chu": "Thời hạn sử dụng: Sử dụng trong suốt quá trình nuôi."
        },
        {
          "kieu": "dong",
          "chu": "Tránh xa trẻ em, đậy kín sản phẩm sau khi sử dụng."
        },
        {
          "kieu": "html",
          "chu": "HƯỚNG DẪN BẢO QUẢN:",
