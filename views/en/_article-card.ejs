<article class="acard<%= locals.big ? ' acard--big' : '' %>">
  <a class="acard__media" href="<%= post.url %>" tabindex="-1" aria-hidden="true">
    <%- img(post.cover, { alt: '', sizes: locals.big ? '(min-width: 1000px) 640px, 100vw' : '(min-width: 1000px) 380px, 100vw', loading: locals.eager ? 'eager' : 'lazy' }) %>
  </a>
  <div class="acard__body">
    <p class="acard__meta">
      <a class="acard__topic" href="/en/knowledge/topic/<%= post.topic %>"><%= post.topicInfo.name %></a>
      <span><%= post.readingMinutes %> min read</span>
    </p>
    <h3 class="acard__title"><a href="<%= post.url %>"><%= post.title %></a></h3>
    <% if (locals.big || !locals.compact) { %><p class="acard__excerpt"><%= post.excerpt %></p><% } %>
  </div>
</article>
