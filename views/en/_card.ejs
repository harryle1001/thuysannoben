<article class="pcard" data-product data-cat="<%= p.category %>" data-sym="<%= p.symptoms.join(' ') %>" data-search="<%= p.search %>"<% if (locals.hidden) { %> hidden<% } %>>
  <a class="pcard__link" href="<%= p.url %>" title="<%= p.name %>">
    <div class="pcard__media cat-bg--<%= p.categoryInfo.vi %>" data-tilt>
      <span class="pcard__floor" aria-hidden="true"></span>
      <%- img(p.shot, { alt: p.name, class: p.cutout ? 'pcard__img is-cutout' : 'pcard__img', sizes: '(min-width: 1100px) 240px, 45vw' }) %>
      <span class="pcard__glare" aria-hidden="true"></span>
    </div>
    <div class="pcard__body">
      <p class="cat-tag cat-tag--<%= p.categoryInfo.vi %>"><%= p.categoryInfo.name %></p>
      <h3 class="pcard__name"><%= p.name %></h3>
      <p class="pcard__tagline"><%= p.tagline %></p>
      <span class="pcard__cta">View details</span>
    </div>
  </a>
</article>
