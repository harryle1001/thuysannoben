<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/en">Home</a></li>
    <% items.forEach(([label, href], i) => { %>
    <li><% if (href && i < items.length - 1) { %><a href="<%= href %>"><%= label %></a><% } else { %><span aria-current="page"><%= label %></span><% } %></li>
    <% }) %>
  </ol>
</nav>
