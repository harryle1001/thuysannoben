<%- include('../partials/header') %>
<section class="page-head page-head--ink">
  <div class="wrap page-head__split">
    <div>
      <%- include('../partials/crumbs', { items: [['Về Noben']] }) %>
      <h1 class="page-head__title"><%- tx('about-title', 'Hơn 22 năm làm thuốc cho ao tôm, cá Việt Nam') %></h1>
      <p class="page-head__lead"><%- ef('company.overview.0', company.overview[0]) %></p>
    </div>
    <figure class="page-head__photo page-head__photo--video">
      <video muted loop playsinline preload="none" data-decor poster="/media/noben-hero-poster.webp" data-hero-video aria-hidden="true">
        <source src="/media/noben-hero.webm" type="video/webm">
        <source src="/media/noben-hero.mp4" type="video/mp4">
      </video>
    </figure>
  </div>
</section>

<section class="section">
  <div class="wrap about-intro">
    <div class="prose prose--lead">
      <% company.overview.slice(1).forEach((p, i) => { %><p><%- ef(`company.overview.${i + 1}`, p) %></p><% }) %>
    </div>
    <dl class="about-facts">
      <div><dt>Hơn <%= company.founded_years %> năm</dt><dd>sản xuất và kinh doanh thuốc thủy sản</dd></div>
      <div><dt><%= productCount %> sản phẩm</dt><dd>chế phẩm sinh học, khoáng, thức ăn bổ sung, hỗ trợ xử lý</dd></div>
      <div><dt>ISO 9001:2015</dt><dd>nhà máy sản xuất tại Củ Chi, TP.HCM</dd></div>
    </dl>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap mvv">
    <div class="mvv__item">
      <h2 class="h3">Tầm nhìn</h2>
      <p><%- ef('company.vision', company.vision) %></p>
    </div>
    <div class="mvv__item">
      <h2 class="h3">Sứ mệnh</h2>
      <p><%- ef('company.mission', company.mission) %></p>
    </div>
    <div class="mvv__item">
      <h2 class="h3">Giá trị cốt lõi</h2>
      <ul class="dia-list"><% company.values.forEach((v, i) => { %><li><%- ef(`company.values.${i}`, v) %></li><% }) %></ul>
    </div>
  </div>
</section>

<%- include('../partials/quality') %>

<section class="section ff" aria-labelledby="ff-title">
  <div class="wrap">
    <p class="ff__kicker">Nhà máy Củ Chi</p>
    <h2 id="ff-title" class="h2">Nhà máy Noben</h2>
    <p class="ff__lead">Từ năm 2002: kiểm tra nguyên liệu, kiểm nghiệm công thức, dây chuyền cân, trộn, đóng gói, chứng nhận ISO 9001:2015 và hợp quy VinaCert, giao hàng toàn quốc.</p>
    <div class="qc__frame ff__frame">
      <video class="qc__video" muted playsinline loop preload="none" width="1920" height="1080" poster="/media/factory/noben-nha-may-poster.webp" data-inview-play aria-label="Phim nhà máy Noben: quy trình sản xuất từ nguyên liệu đến thành phẩm">
        <source src="/media/factory/noben-nha-may-9x16.mp4" type="video/mp4" media="(max-width: 600px) and (orientation: portrait)">
        <source src="/media/factory/noben-nha-may.webm" type="video/webm">
        <source src="/media/factory/noben-nha-may.mp4" type="video/mp4">
      </video>
      <div class="qc__ctrl">
        <button class="qc__sound" type="button" data-video-toggle aria-label="Tạm dừng video"><svg class="ico" aria-hidden="true"><use href="#i-play"/></svg><span>Tạm dừng</span></button>
      </div>
    </div>
  </div>
</section>

<% if (company.youtube && company.youtube.length) { %>
<section class="section section--tint" aria-labelledby="vid-title">
  <div class="wrap">
    <h2 id="vid-title" class="h2">Video</h2>
    <div class="videos">
      <% company.youtube.forEach((id) => { %>
      <div class="yt" data-yt="<%= id %>">
        <img src="https://i.ytimg.com/vi/<%= id %>/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
        <a class="yt__play" href="https://www.youtube.com/watch?v=<%= id %>" target="_blank" rel="noopener"><svg class="ico"><use href="#i-play"/></svg><span>Xem video</span></a>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="wrap section-head">
    <h2 class="h2">Chứng nhận chất lượng</h2>
    <a class="btn btn--line" href="/chung-nhan">Xem giấy chứng nhận</a>
  </div>
</section>

<%- include('../partials/quick-contact') %>
<%- include('../partials/footer') %>
