<%- include('../partials/header') %>
<%
  const cat = categories.find((c) => c.slug === filters.category);
  const visible = new Set(list);
%>
<section class="page-head">
  <div class="wrap">
    <%- include('../partials/crumbs', { items: cat ? [['Sản phẩm', '/san-pham'], [cat.name]] : [['Sản phẩm']] }) %>
    <h1 class="page-head__title"><%= heading %></h1>
    <p class="page-head__lead"><%= cat ? cat.blurb : 'Lọc theo nhóm sản phẩm hoặc theo vấn đề ao nuôi đang gặp. Gõ tên sản phẩm hoặc triệu chứng, có dấu hay không dấu đều được.' %></p>
  </div>
</section>

<div class="wrap catalog" data-catalog data-locked="<%= lockedCategory %>">
  <form class="filters" action="<%= lockedCategory ? path : '/san-pham' %>" method="get" data-filters>
    <div class="field field--search">
      <label for="q" class="sr-only">Tìm sản phẩm</label>
      <svg class="ico"><use href="#i-search"/></svg>
      <input id="q" name="q" type="search" value="<%= filters.q %>" placeholder="Tìm: phân trắng, khoáng, BKC…" autocomplete="off" data-filter-q>
    </div>

    <% if (!lockedCategory) { %>
    <fieldset class="filters__group">
      <legend>Nhóm sản phẩm</legend>
      <div class="filters__radios">
      <label class="radio"><input type="radio" name="nhom" value="" <%= !filters.category ? 'checked' : '' %> data-filter-cat><span>Tất cả</span><small><%= all.length %></small></label>
      <% for (const c of categories) { %>
      <label class="radio"><input type="radio" name="nhom" value="<%= c.slug %>" <%= filters.category === c.slug ? 'checked' : '' %> data-filter-cat><span><i class="dia dia--<%= c.slug %>"></i><%= c.name %></span><small><%= c.count %></small></label>
      <% } %>
      </div>
    </fieldset>
    <% } else { %>
    <p class="filters__back"><a class="text-link" href="/san-pham">Xem tất cả nhóm sản phẩm</a></p>
    <% } %>

    <fieldset class="filters__group">
      <legend>Vấn đề ao nuôi</legend>
      <div class="filters__chips">
        <label class="chip chip--light"><input type="radio" name="van-de" value="" <%= !filters.symptom ? 'checked' : '' %> data-filter-sym><span>Tất cả</span></label>
        <% for (const s of symptoms) { %>
        <label class="chip chip--light"><input type="radio" name="van-de" value="<%= s.slug %>" <%= filters.symptom === s.slug ? 'checked' : '' %> data-filter-sym><span><%= s.label %></span></label>
        <% } %>
      </div>
    </fieldset>
    <noscript><button class="btn btn--blue" type="submit">Lọc sản phẩm</button></noscript>
  </form>

  <section class="catalog__results" aria-labelledby="result-count">
    <p class="catalog__count" id="result-count" aria-live="polite"><span data-count><%= list.length %></span> sản phẩm</p>
    <div class="pgrid pgrid--catalog">
      <% for (const p of all) { if (lockedCategory && p.category !== filters.category) continue; %>
        <%- include('../partials/product-card', { p, hidden: !visible.has(p) }) %>
      <% } %>
    </div>
    <div class="empty" data-empty<% if (list.length) { %> hidden<% } %>>
      <h2 class="h3">Chưa có sản phẩm khớp với lựa chọn này</h2>
      <p>Thử bỏ bớt điều kiện lọc, hoặc gọi <a href="<%= tel(company.hotline) %>"><%= company.hotline %></a> để kỹ thuật viên chọn sản phẩm giúp bạn.</p>
      <a class="btn btn--line" href="<%= lockedCategory ? path : '/san-pham' %>" data-reset>Xóa bộ lọc</a>
    </div>
  </section>
</div>

<%- include('../partials/quick-contact', { title: 'Chưa chắc nên dùng sản phẩm nào?' }) %>
<%- include('../partials/footer') %>
