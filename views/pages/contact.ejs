<%- include('../partials/header') %>
<%
  const v = (k) => (values && values[k]) || (prefill && prefill[k]) || '';
  const needSel = v('need') || 'Tư vấn kỹ thuật';
%>
<section class="page-head">
  <div class="wrap">
    <%- include('../partials/crumbs', { items: [['Liên hệ']] }) %>
    <h1 class="page-head__title"><%- tx('contact-title', 'Liên hệ Noben') %></h1>
    <p class="page-head__lead"><%- tx('contact-lead', 'Gọi hotline để được tư vấn ngay, hoặc để lại lời nhắn, kỹ thuật viên sẽ gọi lại cho bạn.') %></p>
  </div>
</section>

<section class="section section--top-tight">
  <div class="wrap contact">
    <div class="contact__info">
      <a class="phone-big phone-big--dark" href="<%= tel(company.hotline) %>"><svg class="ico"><use href="#i-phone"/></svg><%- ef('company.hotline', company.hotline) %></a>
      <p class="contact__hint">Hotline tư vấn kỹ thuật và đặt hàng</p>
      <dl class="contact__list">
        <div><dt>Phòng kinh doanh</dt><dd><% company.phones.forEach((p, i) => { %><a href="<%= tel(p) %>"><%= p %></a><%= i < company.phones.length - 1 ? ', ' : '' %><% }) %></dd></div>
        <div><dt>Zalo</dt><dd><a href="<%= zaloUrl %>" target="_blank" rel="noopener">Nhắn tin Zalo <%= company.hotline %></a></dd></div>
        <div><dt>Email</dt><dd><a href="mailto:<%= company.email %>"><%- ef('company.email', company.email) %></a></dd></div>
        <div><dt>Địa chỉ</dt><dd><%- ef('company.address', company.address) %></dd></div>
      </dl>
      <div class="map">
        <iframe title="Bản đồ đường đến Công ty TNHH Noben" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=<%= encodeURIComponent(company.address) %>&output=embed"></iframe>
      </div>
    </div>

    <div>
      <% if (sent) { %>
      <div class="notice notice--ok" role="status">
        <svg class="ico"><use href="#i-check"/></svg>
        <div><h2 class="h3">Đã gửi lời nhắn</h2><p>Cảm ơn bạn. Kỹ thuật viên Noben sẽ gọi lại trong giờ làm việc. Cần gấp, gọi <a href="<%= tel(company.hotline) %>"><%= company.hotline %></a>.</p></div>
      </div>
      <% } %>
      <form class="form form--card" action="/lien-he" method="post" data-lead-form novalidate>
        <h2 class="form__title">Gửi lời nhắn</h2>
        <div class="form__row">
          <div class="field<%= errors.name ? ' field--invalid' : '' %>">
            <label for="c-name">Họ tên</label>
            <input id="c-name" name="name" autocomplete="name" required minlength="2" value="<%= v('name') %>"<% if (errors.name) { %> aria-invalid="true" aria-describedby="c-name-err"<% } %>>
            <p class="field__error" id="c-name-err" data-error-for="name"><%= errors.name || '' %></p>
          </div>
          <div class="field<%= errors.phone ? ' field--invalid' : '' %>">
            <label for="c-phone">Số điện thoại</label>
            <input id="c-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required value="<%= v('phone') %>"<% if (errors.phone) { %> aria-invalid="true" aria-describedby="c-phone-err"<% } %>>
            <p class="field__error" id="c-phone-err" data-error-for="phone"><%= errors.phone || '' %></p>
          </div>
        </div>
        <div class="form__row">
          <div class="field">
            <label for="c-need">Bạn cần</label>
            <select id="c-need" name="need">
              <% needs.forEach((n) => { %><option<%= n === needSel ? ' selected' : '' %>><%= n %></option><% }) %>
            </select>
          </div>
          <div class="field">
            <label for="c-province">Tỉnh, thành phố <span class="opt">(không bắt buộc)</span></label>
            <input id="c-province" name="province" autocomplete="address-level1" value="<%= v('province') %>">
          </div>
        </div>
        <div class="field">
          <label for="c-product">Sản phẩm quan tâm <span class="opt">(không bắt buộc)</span></label>
          <input id="c-product" name="product" value="<%= v('product') %>">
        </div>
        <div class="field">
          <label for="c-message">Lời nhắn</label>
          <textarea id="c-message" name="message" rows="5" placeholder="Ví dụ: Ao 3.000 m², tôm 35 ngày, phân trắng nổi mặt nước…"><%= v('message') %></textarea>
          <p class="field__help">Mô tả diện tích ao, tuổi tôm và triệu chứng để kỹ thuật viên tư vấn chính xác hơn.</p>
        </div>
        <input type="hidden" name="page" value="/lien-he">
        <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>
        <button class="btn btn--blue" type="submit">Gửi lời nhắn</button>
        <p class="form__status" role="status" data-form-status></p>
      </form>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
