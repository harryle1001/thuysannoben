<%- include('../partials/header') %>
<%
  const firstSym = symptoms[0];
  const firstList = allProducts.filter((p) => p.symptoms.includes(firstSym.slug)).sort((a, b) => b.symscore[firstSym.slug] - a.symscore[firstSym.slug]);
  const finderData = allProducts.map((p) => ({ n: p.name, u: p.url, i: p.image && p.image.src, s: p.symptoms, r: p.symscore }));
  const factory = { src: '/images/brand/banner-1.webp', w: 1200, h: 745 };
%>
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="hero__kicker"><%- tx('home-kicker', 'Nhà sản xuất thuốc thủy sản tại Củ Chi, TP.HCM') %></p>
      <h1 id="hero-title" class="hero__title"><%- tx('home-title', 'Thuốc thủy sản cho từng vấn\u00a0đề của ao\u00a0tôm') %></h1>
      <p class="hero__lead"><%- tx('home-lead', productCount + ' sản phẩm do nhà máy Noben sản xuất theo ISO 9001:2015, từ vi sinh xử lý đáy, khoáng, men tiêu hóa đến thuốc đặc trị. Chọn vấn đề ao bạn đang gặp để xem sản phẩm phù hợp.') %></p>

      <ul class="badges" aria-label="Chứng nhận và kinh nghiệm">
        <li><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg>ISO 9001:2015</li>
        <li><svg class="ico" aria-hidden="true"><use href="#i-file"/></svg>Hợp quy VinaCert</li>
        <li><svg class="ico" aria-hidden="true"><use href="#i-factory"/></svg>Hơn <%= company.founded_years %> năm sản xuất</li>
      </ul>

      <div class="finder" data-finder>
        <p class="finder__label" id="finder-label"><%- tx('home-finder', 'Ao của bạn đang gặp:') %></p>
        <div class="finder__chips" role="group" aria-labelledby="finder-label">
          <% symptoms.forEach((s, i) => { %>
          <a class="chip" href="/san-pham?van-de=<%= s.slug %>" data-sym="<%= s.slug %>" aria-pressed="<%= i === 0 %>"><%= s.label %></a>
          <% }) %>
        </div>
        <div class="finder__result" aria-live="polite">
          <ul class="finder__list" data-finder-list>
            <% firstList.slice(0, 5).forEach((p) => { %>
            <li><a href="<%= p.url %>"><%- img(p.image, { alt: '', loading: 'eager' }) %><span><%= p.name %></span></a></li>
            <% }) %>
          </ul>
          <a class="finder__more" href="/san-pham?van-de=<%= firstSym.slug %>" data-finder-more>Xem cả <span data-finder-count><%= firstList.length %></span> sản phẩm cho vấn đề này</a>
        </div>
        <script type="application/json" data-finder-data><%- JSON.stringify(finderData).replace(/</g, '\\u003c') %></script>
      </div>
    </div>

    <figure class="hero__photo">
      <%- img(factory, { alt: 'Nhà máy Công ty TNHH Noben nhìn từ trên cao', loading: 'eager', fetchpriority: 'high' }) %>
      <figcaption><%- tx('home-photo', 'Nhà máy Noben, xã Tân Phú Trung, Củ Chi') %></figcaption>
      <span class="iso-badge" aria-hidden="true"><span>ISO<br>9001<br>2015</span></span>
    </figure>
  </div>
</section>

<section class="facts" aria-label="Noben trong vài con số">
  <div class="wrap facts__row">
    <p class="fact"><strong><%- tx('fact-1', 'Hơn ' + company.founded_years + ' năm') %></strong><span><%- tx('fact-1-note', 'sản xuất thuốc thủy sản') %></span></p>
    <p class="fact"><strong><%- tx('fact-2', productCount + ' sản phẩm') %></strong><span><%- tx('fact-2-note', 'trong 4 nhóm chuyên dụng') %></span></p>
    <p class="fact"><strong><%- tx('fact-3', 'ISO 9001:2015') %></strong><span><%- tx('fact-3-note', 'hệ thống quản lý chất lượng nhà máy') %></span></p>
    <p class="fact"><strong><%- tx('fact-4', 'Hợp quy VinaCert') %></strong><span><%- tx('fact-4-note', 'sản phẩm thức ăn bổ sung') %></span></p>
  </div>
</section>

<section class="section" aria-labelledby="sol-title">
  <div class="wrap">
    <header class="section-head">
      <div>
        <h2 id="sol-title" class="h2"><%- tx('home-solutions', 'Giải pháp theo vấn đề ao nuôi') %></h2>
        <p class="section-head__lead"><%- tx('home-solutions-lead', 'Mỗi vấn đề có dấu hiệu, các bước xử lý và bộ sản phẩm phù hợp do kỹ thuật viên Noben tổng hợp.') %></p>
      </div>
      <a class="text-link" href="/giai-phap">Tất cả giải pháp</a>
    </header>
    <%- include('../partials/solution-tiles', { solutions }) %>
  </div>
</section>

<section class="section section--tint" aria-labelledby="groups-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="groups-title" class="h2"><%- tx('home-groups', 'Bốn nhóm sản phẩm') %></h2>
      <a class="text-link" href="/san-pham">Xem toàn bộ <%= productCount %> sản phẩm</a>
    </header>
    <ul class="groups">
      <% for (const cat of categories) { const sample = allProducts.filter((p) => p.category === cat.slug).slice(0, 4); %>
      <li class="group group--<%= cat.slug %>">
        <a class="group__link" href="/san-pham/nhom/<%= cat.slug %>">
          <div class="group__text">
            <h3 class="group__name"><%- ef(`categories.${cat.slug}.name`, cat.name) %></h3>
            <p class="group__blurb"><%- ef(`categories.${cat.slug}.blurb`, cat.blurb) %></p>
            <span class="group__count"><%= cat.count %> sản phẩm</span>
          </div>
          <div class="group__shelf" aria-hidden="true">
            <% sample.forEach((p) => { %><%- img(p.image, { alt: '' }) %><% }) %>
          </div>
        </a>
      </li>
      <% } %>
    </ul>
  </div>
</section>

<%
  const bySlug = Object.fromEntries(allProducts.map((p) => [p.slug, p]));
  const stages = [
    { when: 'Chuẩn bị ao', goal: 'Diệt tạp, diệt khuẩn nguồn nước, gây màu và cấy vi sinh trước khi thả giống.', items: ['d-oc', 'ben-bkc-80', 'nb-brown-gay-mau-nuoc-mau-tra', 'proticbest'] },
    { when: '1 đến 30 ngày', goal: 'Xây nền gan ruột khỏe, phòng hoại tử gan tụy và chết sớm.', items: ['aqualac-fs', 'sorbest', 'aqua-bac'] },
    { when: '31 đến 60 ngày', goal: 'Phòng phân trắng, xổ ký sinh trùng, giữ khoáng và độ kiềm ổn định.', items: ['prazi-s', 'mega-cid', 'miral-n8'] },
    { when: 'Trên 60 ngày', goal: 'Tăng trọng, cứng vỏ, giữ đáy sạch và oxy đủ đến ngày thu hoạch.', items: ['caphote', 'top-weigh', 'super-yucca'] },
  ];
%>
<section class="stages" aria-labelledby="stages-title">
  <div class="wrap">
    <header class="section-head section-head--light">
      <div>
        <h2 id="stages-title" class="h2"><%- tx('home-stages', 'Đồng hành theo từng giai đoạn nuôi') %></h2>
        <p class="section-head__lead"><%- tx('home-stages-lead', 'Bộ sản phẩm gợi ý cho từng giai đoạn của vụ tôm thẻ chân trắng, từ chuẩn bị ao đến thu hoạch.') %></p>
      </div>
      <a class="text-link text-link--light" href="/bai-viet/lich-cham-soc-tom-the-theo-ngay-tuoi">Xem lịch chăm sóc chi tiết</a>
    </header>
    <ol class="stage-list">
      <% stages.forEach((s) => { %>
      <li class="stage">
        <p class="stage__when"><%= s.when %></p>
        <p class="stage__goal"><%= s.goal %></p>
        <ul class="stage__products">
          <% s.items.map((x) => bySlug[x]).filter(Boolean).forEach((p) => { %>
          <li><a href="<%= p.url %>"><%- img(p.image, { alt: '' }) %><span><%= p.name %></span></a></li>
          <% }) %>
        </ul>
      </li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="featured-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="featured-title" class="h2"><%- tx('home-featured', 'Sản phẩm bà con hỏi nhiều') %></h2>
      <a class="text-link" href="/san-pham">Tất cả sản phẩm</a>
    </header>
    <div class="pgrid">
      <% featured.forEach((p) => { %><%- include('../partials/product-card', { p }) %><% }) %>
    </div>
  </div>
</section>

<section class="section section--tint" aria-labelledby="kt-title">
  <div class="wrap">
    <header class="section-head">
      <div>
        <h2 id="kt-title" class="h2"><%- tx('home-kt', 'Kiến thức nuôi tôm') %></h2>
        <p class="section-head__lead"><%- tx('home-kt-lead', 'Cẩm nang nhận biết bệnh, quản lý môi trường và kỹ thuật nuôi do đội kỹ thuật Noben biên soạn từ ao nuôi thực tế.') %></p>
      </div>
      <a class="text-link" href="/ky-thuat-nuoi">Xem tất cả <%= knowledgeCount %> bài viết</a>
    </header>
    <nav class="topic-nav" aria-label="Chuyên mục kiến thức">
      <% topics.forEach((t) => { %><a class="topic-chip" href="/ky-thuat-nuoi/<%= t.slug %>"><%= t.name %></a><% }) %>
    </nav>
    <% if (articles.length) { const [lead, ...rest] = articles; %>
    <div class="kfeature">
      <%- include('../partials/article-card', { post: lead, big: true }) %>
      <div class="kfeature__side">
        <% rest.slice(0, 3).forEach((p) => { %><%- include('../partials/article-card', { post: p, compact: true }) %><% }) %>
      </div>
    </div>
    <% } %>
  </div>
</section>

<section class="section" aria-labelledby="why-title">
  <div class="wrap why">
    <figure class="why__photo">
      <%- img({ src: '/images/brand/banner-2.webp', w: 1200, h: 745 }, { alt: 'Nhà máy sản xuất của Noben tại Củ Chi' }) %>
    </figure>
    <div>
      <h2 id="why-title" class="h2"><%- tx('home-why', 'Vì sao bà con và đại lý chọn Noben') %></h2>
      <dl class="why__list">
        <div><dt><%- tx('why-1', 'Sản xuất tại nhà máy riêng') %></dt><dd><%- tx('why-1-d', 'Dây chuyền tự động hóa, hệ thống quản lý chất lượng đạt ISO 9001:2015, kiểm soát từng lô hàng.') %></dd></div>
        <div><dt><%- tx('why-2', 'Đủ giải pháp cho cả vụ nuôi') %></dt><dd><%- tx('why-2-d', productCount + ' sản phẩm trong 4 nhóm: chế phẩm sinh học, khoáng chất, thức ăn bổ sung và đặc trị.') %></dd></div>
        <div><dt><%- tx('why-3', 'Kỹ thuật viên đồng hành') %></dt><dd><%- tx('why-3-d', 'Tư vấn miễn phí qua điện thoại và Zalo, lên phác đồ theo tình trạng thực tế của từng ao.') %></dd></div>
        <div><dt><%- tx('why-4', 'Hơn 15 năm trong nghề') %></dt><dd><%- tx('why-4-d', 'Kinh nghiệm sản xuất, phân phối và gia công thuốc thủy sản cho bà con, đại lý và doanh nghiệp.') %></dd></div>
      </dl>
      <div class="btn-row">
        <a class="btn btn--blue" href="/ve-chung-toi">Tìm hiểu về Noben</a>
        <a class="btn btn--line" href="/lien-he?nhu-cau=L%C3%A0m%20%C4%91%E1%BA%A1i%20l%C3%BD">Đăng ký làm đại lý</a>
      </div>
    </div>
  </div>
</section>

<section class="oem-band" aria-labelledby="oem-title">
  <div class="wrap oem-band__grid">
    <div>
      <h2 id="oem-title" class="h2"><%- tx('home-oem', 'Gia công thuốc thủy sản theo đơn đặt hàng') %></h2>
      <p class="lead"><%- tx('home-oem-lead', 'Doanh nghiệp muốn có thương hiệu riêng có thể đặt Noben sản xuất trên dây chuyền tự động hóa của nhà máy đạt ISO 9001:2015.') %></p>
      <ul class="ticks">
        <li><svg class="ico"><use href="#i-check"/></svg><span><%- tx('home-oem-1', 'Gia công thành phẩm và bán thành phẩm') %></span></li>
        <li><svg class="ico"><use href="#i-check"/></svg><span><%- tx('home-oem-2', 'Tư vấn hồ sơ đăng ký lưu hành, cấp mã số sản phẩm') %></span></li>
        <li><svg class="ico"><use href="#i-check"/></svg><span><%- tx('home-oem-3', 'Tư vấn thành lập công ty và báo giá gia công') %></span></li>
      </ul>
      <a class="btn btn--sun" href="/gia-cong">Tìm hiểu dịch vụ gia công</a>
    </div>
    <figure class="oem-band__photo">
      <%- img({ src: '/images/brand/gioi-thieu.webp', w: 532, h: 250 }, { alt: 'Khu nhà xưởng sản xuất của Noben' }) %>
    </figure>
  </div>
</section>

<% if (certificates.length) { %>
<section class="section" aria-labelledby="cert-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="cert-title" class="h2"><%- tx('home-cert', 'Chứng nhận chất lượng') %></h2>
      <a class="text-link" href="/chung-nhan">Xem tất cả chứng nhận</a>
    </header>
    <div class="certs" data-gallery>
      <% certificates.forEach((c, i) => { %>
      <a class="cert" href="<%= c.src %>" data-lb="<%= c.src %>" data-caption="Chứng nhận của Công ty TNHH Noben">
        <%- img(c, { alt: 'Giấy chứng nhận của Công ty TNHH Noben, trang ' + (i + 1) }) %>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('../partials/quick-contact') %>
<%- include('../partials/footer') %>
