<%- include('../partials/header') %>
<section class="sol-hero">
  <div class="wrap sol-hero__grid">
    <div>
      <%- include('../partials/crumbs', { items: [['Giải pháp', '/giai-phap'], [s.symptomInfo ? s.symptomInfo.label : s.h1]] }) %>
      <h1 class="sol-hero__title"><%= s.h1 %></h1>
      <p class="sol-hero__lead"><%= s.intro %></p>
      <div class="btn-row">
        <a class="btn btn--sun" href="<%= tel(company.hotline) %>"><svg class="ico"><use href="#i-phone"/></svg>Gọi kỹ thuật viên <%= company.hotline %></a>
        <a class="btn btn--ghost" href="#san-pham">Xem <%= products.length %> sản phẩm phù hợp</a>
      </div>
    </div>
    <div class="sol-card">
      <h2 class="sol-card__title">Dấu hiệu thường gặp</h2>
      <ul class="checks">
        <% s.signs.forEach((x) => { %><li><svg class="ico" aria-hidden="true"><use href="#i-check"/></svg><span><%= x %></span></li><% }) %>
      </ul>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="steps-title">
  <div class="wrap">
    <h2 id="steps-title" class="h2">Các bước xử lý</h2>
    <ol class="steps steps--solution">
      <% s.steps.forEach((x) => { %><li><p><%= x %></p></li><% }) %>
    </ol>
    <p class="spec__note sol-note">Liều dùng cụ thể theo hướng dẫn trên nhãn từng sản phẩm và tình trạng ao. Gọi <a href="<%= tel(company.hotline) %>"><%= company.hotline %></a> để kỹ thuật viên lên phác đồ cho ao của bạn.</p>
  </div>
</section>

<section class="section section--tint" id="san-pham" aria-labelledby="sp-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="sp-title" class="h2">Sản phẩm phù hợp</h2>
      <a class="text-link" href="/san-pham?van-de=<%= s.symptom %>">Lọc trong danh mục sản phẩm</a>
    </header>
    <div class="pgrid">
      <% products.slice(0, 12).forEach((p) => { %><%- include('../partials/product-card', { p }) %><% }) %>
    </div>
  </div>
</section>

<% if (articles.length) { %>
<section class="section" aria-labelledby="art-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="art-title" class="h2">Bài viết hướng dẫn chi tiết</h2>
      <a class="text-link" href="/ky-thuat-nuoi">Kiến thức nuôi tôm</a>
    </header>
    <div class="agrid">
      <% articles.forEach((p) => { %><%- include('../partials/article-card', { post: p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (s.faq && s.faq.length) { %>
<section class="section section--tint" aria-labelledby="faq-title">
  <div class="wrap faq-wrap">
    <h2 id="faq-title" class="h2">Câu hỏi thường gặp</h2>
    <div class="faq">
      <% s.faq.forEach((f, i) => { %>
      <details class="faq__item"<% if (i === 0) { %> open<% } %>><summary><%= f.q %></summary><div class="faq__a"><p><%= f.a %></p></div></details>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" aria-labelledby="other-title">
  <div class="wrap">
    <h2 id="other-title" class="h2">Vấn đề khác của ao nuôi</h2>
    <%- include('../partials/solution-tiles', { solutions: others }) %>
  </div>
</section>

<%- include('../partials/quick-contact', { title: 'Gửi tình trạng ao, nhận phác đồ xử lý' }) %>
<%- include('../partials/footer') %>
