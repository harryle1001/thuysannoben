<%
  const m = locals.meta || {};
  const isEn = locals.lang === 'en';
  const site = isEn ? 'Noben Aquaculture' : 'Thủy sản Noben';
  const fullTitle0 = !m.title ? site : /Noben/.test(m.title) || m.title.length > 50 ? m.title : `${m.title} – ${site}`;
  // title tối đa ~65 ký tự (Google cắt phần dư): bỏ đuôi tên site trước, rồi cắt theo từ
  const cutW = (t, n) => (t.length <= n ? t : t.slice(0, n + 1).replace(/\s+\S*$/, '').replace(/[\s,:;–|-]+$/, ''));
  const fullTitle = fullTitle0.length <= 65 ? fullTitle0 : (() => { const bare = fullTitle0.replace(/\s*[–|-]\s*(Thủy sản Noben|Thuốc thủy sản Noben|Noben Aquaculture|Noben)\s*$/, ''); return bare.length <= 65 ? bare : cutW(bare, 62); })();
  const desc0 = m.description || (isEn ? 'NOBEN CO., LTD manufactures aquaculture health products, probiotics, minerals and feed supplements for shrimp and fish ponds.' : '') || 'Công ty TNHH Noben sản xuất thuốc thú y thủy sản, chế phẩm sinh học, khoáng chất và thức ăn bổ sung cho ao tôm, cá.';
  // mô tả tối đa ~158 ký tự: cắt ở cuối câu hoặc cuối từ, không để dở dang
  const desc = desc0.length <= 158 ? desc0 : (() => {
    // giữ trọn câu theo thứ tự, bỏ câu không vừa; nếu vẫn ngắn (<120) thì cắt theo từ để tận dụng chỗ
    const ss = desc0.match(/[^.!?]+[.!?]+(\s|$)|[^.!?]+$/g) || [desc0];
    let out = ss[0].trim().length <= 158 ? ss[0].trim() : '';
    for (const s of ss.slice(1)) { const t = s.trim(); if (out && (out + ' ' + t).length <= 158) out += ' ' + t; }
    if (out.length >= 120) return out;
    return desc0.slice(0, 157).replace(/\s+\S*$/, '').replace(/[\s,:;–-]+$/, '') + '…';
  })();
  const ogImage = /^https?:/.test(m.image || '') ? m.image : siteUrl + (m.image || '/images/brand/banner-1.webp');
%><!doctype html>
<html lang="<%= isEn ? 'en' : 'vi' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= fullTitle %></title>
  <meta name="description" content="<%= desc %>">
  <% if (m.keywords) { %><meta name="keywords" content="<%= m.keywords %>"><% } %>
  <meta name="robots" content="<%= m.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1' %>">
  <link rel="canonical" href="<%= canonical %>">
  <% if (locals.gaId && !locals.isAdmin) { %><script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script><script src="/js/analytics.js?v=1" data-ga="<%= gaId %>" defer></script><% } %>
  <% if (locals.googleVerify) { %><meta name="google-site-verification" content="<%= googleVerify %>"><% } %>
  <meta property="og:type" content="<%= m.type === 'article' ? 'article' : 'website' %>">
  <meta property="og:site_name" content="<%= site %>">
  <meta property="og:locale" content="<%= isEn ? 'en_US' : 'vi_VN' %>">
  <meta property="og:title" content="<%= fullTitle %>">
  <meta property="og:description" content="<%= desc %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:alt" content="<%= m.title || site %>">
  <% if (m.published) { %><meta property="article:published_time" content="<%= m.published %>"><meta property="article:modified_time" content="<%= m.modified || m.published %>"><meta property="article:publisher" content="https://www.facebook.com/107785190995978"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <% if (!isEn) { %><link rel="alternate" type="application/rss+xml" title="Kiến thức nuôi tôm – Thủy sản Noben" href="/rss.xml"><% } %>
  <% if (locals.alt && alt.en) { %><link rel="alternate" hreflang="vi" href="<%= siteUrl + (alt.vi === '/' ? '/' : alt.vi) %>">
  <link rel="alternate" hreflang="en" href="<%= siteUrl + alt.en %>">
  <link rel="alternate" hreflang="x-default" href="<%= siteUrl + (alt.vi === '/' ? '/' : alt.vi) %>"><% } else { %><link rel="alternate" hreflang="vi" href="<%= canonical %>"><% } %>
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#0b2347">
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml">
  <link rel="icon" href="/favicon.png?v=2" type="image/png" sizes="64x64">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
  <link rel="preload" href="/fonts/playfair-display-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/be-vietnam-pro-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <% if (m.preloadImage) { %><link rel="preload" as="image" href="<%= m.preloadImage %>" fetchpriority="high"<% if (m.preloadImagePhone) { %> media="(min-width: 761px)"<% } %>><% } %>
  <% if (m.preloadImagePhone) { %><link rel="preload" as="image" href="<%= m.preloadImagePhone %>" fetchpriority="high" media="(max-width: 760px)"><% } %>
  <script src="/js/theme.js?v=1"></script>
  <link rel="stylesheet" href="/css/main.css?v=65">
  <% if (m.css) { %><link rel="stylesheet" href="<%= m.css %>"><% } %>
  <% for (const block of (locals.jsonld || [])) { %>
  <script type="application/ld+json"><%- JSON.stringify(block).replace(/</g, '\\u003c') %></script>
  <% } %>
  <script src="/js/smooth.js?v=3" defer></script>
  <script src="/js/sunrise-bg.js?v=7" defer></script>
  <script src="/js/scroll-motion.js?v=4" defer></script>
  <script src="/js/main.js?v=20" defer></script>
  <script src="/js/certflow.js?v=3" defer></script>
  <script src="/js/showcase.js?v=2" defer></script>
  <% if (!isEn) { %><script src="/js/chat.js?v=2" defer></script>
  <script src="/js/quote.js?v=1" defer></script><% } %>
  <% if (locals.isAdmin) { %><script src="/js/editor.js?v=1" defer></script><% } %>
</head>
<body>
<%- include('icons') %>
<a class="skip" href="#noi-dung"><%= isEn ? 'Skip to main content' : 'Bỏ qua, đến nội dung chính' %></a>
