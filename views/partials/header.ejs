<%- include('head') %>
<%
  const nav = [
    ['/san-pham', 'Sản phẩm'],
    ['/giai-phap', 'Giải pháp'],
    ['/ky-thuat-nuoi', 'Kiến thức nuôi tôm'],
    ['/gia-cong', 'Gia công'],
    ['/ve-chung-toi', 'Về Noben'],
    ['/lien-he', 'Liên hệ'],
  ];
  const active = (href) => path === href || path.startsWith(href + '/');
%>
<div class="topbar">
  <div class="wrap topbar__row">
    <p class="topbar__note"><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg><%- tx('topbar-note', 'Nhà máy đạt ISO 9001:2015 tại Củ Chi. Kỹ thuật viên tư vấn miễn phí cho từng ao.') %></p>
    <p class="topbar__links"><a href="mailto:<%= company.email %>"><%= company.email %></a></p>
  </div>
</div>
<header class="site-header" data-header>
  <div class="wrap site-header__bar">
    <a class="brand" href="/" aria-label="Thủy sản Noben, về trang chủ">
      <img src="/images/brand/logo-noben.webp" width="56" height="56" alt="">
      <span class="brand__text"><strong>Noben</strong><small>Thuốc thủy sản</small></span>
    </a>
    <nav class="nav" id="menu" aria-label="Menu chính">
      <ul class="nav__list">
        <% for (const [href, label] of nav) { %>
        <li><a class="nav__link" href="<%= href %>"<% if (active(href)) { %> aria-current="page"<% } %>><%= label %></a></li>
        <% } %>
      </ul>
      <div class="nav__mobile-extra">
        <a class="btn btn--sun btn--block" href="<%= tel(company.hotline) %>"><svg class="ico"><use href="#i-phone"/></svg> Gọi <%= company.hotline %></a>
        <a class="btn btn--line btn--block" href="<%= zaloUrl %>" rel="noopener" target="_blank"><svg class="ico"><use href="#i-chat"/></svg> Nhắn Zalo</a>
      </div>
    </nav>
    <div class="site-header__actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Chuyển sang giao diện tối" aria-pressed="false">
        <svg class="ico ico--moon" aria-hidden="true"><use href="#i-moon"/></svg>
        <svg class="ico ico--sun" aria-hidden="true"><use href="#i-sun"/></svg>
      </button>
      <a class="btn btn--sun site-header__call" href="<%= tel(company.hotline) %>">
        <svg class="ico"><use href="#i-phone"/></svg>
        <span><small>Hotline kỹ thuật</small><%- ef('company.hotline', company.hotline) %></span>
      </a>
      <button class="menu-toggle" type="button" aria-controls="menu" aria-expanded="false" data-menu-toggle>
        <svg class="ico ico--open"><use href="#i-menu"/></svg>
        <svg class="ico ico--close"><use href="#i-x"/></svg>
        <span class="sr-only">Mở menu</span>
      </button>
    </div>
  </div>
</header>
<main id="noi-dung">
