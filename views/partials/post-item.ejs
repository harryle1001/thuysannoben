<article class="post-item">
  <a class="post-item__media" href="<%= post.url %>" tabindex="-1" aria-hidden="true"><%- img(post.cover, { alt: '', sizes: '(min-width: 900px) 280px, 100vw' }) %></a>
  <div class="post-item__body">
    <h3 class="post-item__title"><a href="<%= post.url %>"><%= post.title %></a></h3>
    <p class="post-item__excerpt"><%= post.excerpt %></p>
    <p class="post-item__meta"><time datetime="<%= post.date %>"><%= post.dateLabel %></time></p>
  </div>
</article>
